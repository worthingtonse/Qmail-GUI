# Mailbox mass-production / USB deployment workspace (not tracked).
Deploy/

# css-analysis tool intermediate cache (regeneratable; outputs in
# docs/css-audit/*.{csv,md} are committed for reviewer convenience).
docs/css-audit/cache/

# Python bytecode from the avatar-sheet vectorizer scripts.
__pycache__/

# Scratch space for artwork: source files (.pdn), design drafts, screenshots
# and anything else not actually referenced by the app. Vite copies all of
# public/ into the build, so parking art directly in public/ ships it to
# every user. Put working art here instead — it stays out of git and out of
# the packaged app (see the "!public/non-committed-art" exclusion in
# vite.config.js). Art that the app actually uses belongs in public/ proper.
public/non-committed-art/

# Working notes, design files, log dumps and AI handoff docs. These are
# scratch/reference material for whoever is working on the repo, not
# shipped source, and some of it (log archives, .pdn art) is large binary
# that git cannot diff or compress. Kept out of history entirely.
docs/
