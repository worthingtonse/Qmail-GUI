{
  "name": "q-mail",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.cjs",
  "description": "QMail-Decentralized.Quantum-Safe.Unsurveillable.",
  "scripts": {
    "dev": "vite",
    "dev2": "cross-env VITE_PORT=5174 VITE_API_PORT=8081 vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "css:audit": "node scripts/css-analysis/inventory.mjs && node scripts/css-analysis/canonicalize.mjs && node scripts/css-analysis/cluster.mjs && node scripts/css-analysis/report.mjs",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-pack": "npm run build && electron-builder --config electron-builder.config.cjs",
    "build-portable": "npm run build && electron-builder --config electron-builder.config.cjs --win portable",
    "build-portable-intl": "npm run build && cross-env QMAIL_BUILD=intl electron-builder --config electron-builder.config.cjs --win portable",
    "build-portable-all": "npm run build-portable && npm run build-portable-intl",
    "build-all": "npm run build && electron-builder --config electron-builder.config.cjs --win --mac --linux",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --publish=never"
  },
  "dependencies": {
    "lucide-react": "^0.552.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.15",
    "vite": "^4.5.3",
    "vitest": "^4.1.7",
    "wait-on": "^7.2.0"
  }
}
